<view class="workspace {{tabs.length ? 'workspace-with-tabs' : ''}}">
  <block wx:if="{{permitted}}">
    <view class="workspace-hero">
      <text class="workspace-role">{{roleLabel}}</text>
      <view class="workspace-title">{{title}}</view>
    </view>
    <view class="workspace-empty" wx:if="{{points !== ''}}">当前积分：{{points}} 分</view>
    <view class="workspace-empty" wx:if="{{emptyText}}">{{emptyText}}</view>
    <view class="workspace-panel" wx:if="{{links.length}}">
      <view class="workspace-heading">快捷入口</view>
      <navigator wx:for="{{links}}" wx:key="url" class="workspace-row" url="{{item.url}}" open-type="{{item.mode}}" hover-class="workspace-pressed">
        <text class="workspace-label">{{item.label}}</text>
        <text class="workspace-arrow">›</text>
      </navigator>
    </view>
    <t-button wx:if="{{backUrl}}" theme="primary" variant="outline" block bind:tap="returnToParent">返回上一页</t-button>
    <t-button wx:else theme="primary" variant="outline" block loading="{{logoutPending}}" disabled="{{logoutPending}}" bind:tap="returnToEntry">{{realMember ? '退出登录' : '切换演示身份'}}</t-button>
    <view wx:if="{{tabs.length}}" class="workspace-tabs" aria-label="{{roleLabel}}导航">
      <block wx:for="{{tabs}}" wx:key="path">
        <view wx:if="{{path === item.path}}" class="workspace-tab workspace-current" aria-label="{{item.label}}，当前页面">{{item.label}}</view>
        <navigator wx:else class="workspace-tab" url="{{item.path}}" open-type="reLaunch" hover-class="workspace-pressed">{{item.label}}</navigator>
      </block>
    </view>
  </block>
  <block wx:else>
    <view class="workspace-empty">请先登录后再进入此页面。</view>
    <t-button theme="primary" block bind:tap="returnToEntry">返回登录</t-button>
  </block>
</view>
