<view class="entry">
  <view class="entry-hero">
    <text class="entry-brand">阳光口腔</text>
    <view class="entry-title">会员登录</view>
  </view>
  <view class="entry-panel">
    <view class="entry-description">新会员登录后填写会员资料。</view>
    <view wx:if="{{error}}" class="entry-error" role="alert">{{error}}</view>
    <t-button theme="primary" block loading="{{opening}}" disabled="{{opening}}" bind:tap="login">微信登录</t-button>
  </view>
  <view wx:if="{{demoAvailable}}" class="entry-panel">
    <view class="entry-note">演示入口 · 无需微信认证</view>
    <view class="entry-option">
      <view class="entry-option-title">会员端</view>
      <view class="entry-description">浏览会员服务</view>
      <t-button theme="primary" variant="outline" block data-role="member" disabled="{{opening}}" bind:tap="openWorkspace">演示会员端</t-button>
    </view>
    <view class="entry-option">
      <view class="entry-option-title">员工端</view>
      <view class="entry-description">打开员工工作台</view>
      <t-button theme="primary" variant="outline" block data-role="employee" disabled="{{opening}}" bind:tap="openWorkspace">演示员工端</t-button>
    </view>
  </view>
</view>
