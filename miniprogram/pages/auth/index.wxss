.entry { padding: 36rpx; }
.entry-hero { padding: 44rpx 36rpx; background: #155aa8; color: white; border-radius: 28rpx; }
.entry-brand { color: #e0edff; font-size: 26rpx; }
.entry-title { margin-top: 16rpx; font-size: 48rpx; font-weight: 700; }
.entry-panel { margin-top: 28rpx; padding: 32rpx; background: white; border-radius: 24rpx; }
.entry-option + .entry-option { padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid #e4ebf3; }
.entry-option-title { font-size: 32rpx; font-weight: 650; }
.entry-description { margin: 8rpx 0 20rpx; color: #60728a; font-size: 26rpx; }
.entry-note { margin-bottom: 20rpx; color: #60728a; font-size: 24rpx; }
.entry-error { color: #a32929; margin: 0 0 20rpx; font-size: 26rpx; }
