<view class="workspace">
  <view class="workspace-hero">
    <text class="workspace-role">会员端</text>
    <view class="workspace-title">会员资料</view>
  </view>
  <view wx:if="{{loading}}" class="workspace-empty">正在读取会员资料…</view>
  <view wx:elif="{{expired}}" class="workspace-panel">
    <view class="profile-message">请先微信登录后查看会员资料。</view>
    <t-button theme="primary" block bind:tap="returnToLogin">返回登录</t-button>
  </view>
  <view wx:elif="{{error}}" class="workspace-panel">
    <view class="profile-message" role="alert">{{error}}</view>
    <t-button theme="primary" variant="outline" block bind:tap="loadProfile">重试</t-button>
  </view>
  <view wx:elif="{{profile}}" class="workspace-panel">
    <view class="workspace-row profile-row"><text>姓名</text><text>{{profile.name}}</text></view>
    <view class="workspace-row profile-row"><text>生日</text><text>{{profile.birthday}}</text></view>
    <view class="workspace-row profile-row"><text>手机号</text><text>{{profile.phone_masked}}</text></view>
    <view class="workspace-row profile-row"><text>会员编号</text><text>{{profile.member_no}}</text></view>
    <view class="workspace-row profile-row"><text>会员状态</text><text>{{profile.status === 'active' ? '正常' : '停用'}}</text></view>
  </view>
</view>
