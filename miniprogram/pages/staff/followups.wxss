@import "../../components/workspace/workspace.wxss";
.followup-item { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #edf1f6; overflow-wrap: anywhere; }
textarea { width: 100%; min-height: 160rpx; padding: 16rpx; box-sizing: border-box; }
.task-overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.35); }
.task-overlay .workspace-panel { width: 80%; }
