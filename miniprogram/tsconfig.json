{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "app.ts",
    "pages/**/*.ts",
    "components/**/*.ts",
    "config/**/*.ts",
    "services/**/*.ts"
  ]
}
