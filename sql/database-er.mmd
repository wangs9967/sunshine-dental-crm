erDiagram
    ACCOUNTS {
        uuid id PK
        varchar wechat_openid UK
        varchar wechat_unionid
        varchar username UK
        varchar password_hash
        varchar status
        timestamptz last_login_at
        timestamptz created_at
        timestamptz updated_at
    }
    STAFF_PROFILES {
        uuid id PK
        uuid account_id FK, UK
        varchar employee_no UK
        varchar display_name
        bytea phone_ciphertext
        bytea phone_search_hash
        varchar role
        varchar status
        date hired_at
        timestamptz disabled_at
        timestamptz created_at
        timestamptz updated_at
    }
    MEMBERS {
        uuid id PK
        uuid account_id FK, UK
        varchar member_no UK
        varchar name
        date birthday
        bytea phone_ciphertext
        bytea phone_search_hash
        varchar register_source
        uuid source_employee_id FK
        varchar status
        timestamptz registered_at
        timestamptz created_at
        timestamptz updated_at
    }
    EMPLOYEE_QR_TOKENS {
        uuid id PK
        uuid staff_id FK
        bytea token_hash UK
        timestamptz expires_at
        timestamptz revoked_at
        timestamptz created_at
    }
    CUSTOMER_ASSIGNMENTS {
        uuid id PK
        uuid member_id FK
        uuid staff_id FK
        boolean is_current
        varchar bind_source
        timestamptz started_at
        timestamptz ended_at
        text change_reason
        uuid operator_account_id FK
        timestamptz created_at
    }
    CUSTOMER_STATUS {
        uuid id PK
        uuid member_id FK, UK
        varchar visit_status
        varchar consume_status
        varchar deal_status
        timestamptz last_visit_at
        timestamptz last_consume_at
        timestamptz next_recall_at
        timestamptz last_effective_contact_at
        uuid updated_by_account_id FK
        timestamptz created_at
        timestamptz updated_at
    }
    CUSTOMER_TAGS {
        uuid id PK
        varchar name UK
        varchar description
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }
    MEMBER_TAG_RELATIONS {
        uuid member_id PK, FK
        uuid tag_id PK, FK
        uuid created_by_account_id FK
        timestamptz created_at
    }
    POINTS_ACCOUNTS {
        uuid id PK
        uuid member_id FK, UK
        bigint balance
        bigint total_earned
        bigint total_spent
        timestamptz created_at
        timestamptz updated_at
    }
    POINTS_RECORDS {
        uuid id PK
        uuid member_id FK
        bigint delta_points
        bigint balance_before
        bigint balance_after
        varchar record_type
        varchar source_type
        uuid exchange_order_id FK, UK
        varchar idempotency_key UK
        bytea request_fingerprint
        text reason
        uuid operator_account_id FK
        timestamptz created_at
    }
    FOLLOWUP_RECORDS {
        uuid id PK
        uuid member_id FK
        uuid staff_id FK
        varchar contact_type
        timestamptz followup_at
        text content
        text customer_feedback
        boolean effective_contact
        boolean gift_given
        varchar gift_name
        timestamptz next_followup_at
        uuid created_by_account_id FK
        timestamptz created_at
    }
    FOLLOWUP_TASKS {
        uuid id PK
        uuid member_id FK
        uuid assigned_staff_id FK
        varchar task_type
        varchar status
        varchar title
        timestamptz scheduled_at
        timestamptz postponed_until
        varchar dedupe_key UK
        text result
        timestamptz completed_at
        uuid created_by_account_id FK
        timestamptz created_at
        timestamptz updated_at
    }
    PRODUCTS {
        uuid id PK
        varchar name
        varchar category
        varchar cover_image_key
        jsonb image_keys
        text description
        bigint points_price
        integer stock
        integer per_user_monthly_limit
        varchar status
        integer sort_order
        integer version
        timestamptz created_at
        timestamptz updated_at
    }
    EXCHANGE_ORDERS {
        uuid id PK
        varchar order_no UK
        uuid member_id FK
        uuid product_id FK
        jsonb product_snapshot
        integer quantity
        bigint points_cost_total
        varchar status
        varchar idempotency_key
        bytea request_fingerprint
        uuid verified_by_account_id FK
        timestamptz verified_at
        timestamptz created_at
        timestamptz updated_at
    }
    PRODUCT_STOCK_RECORDS {
        uuid id PK
        uuid product_id FK
        uuid exchange_order_id FK, UK
        uuid operator_account_id FK
        varchar change_type
        integer quantity_delta
        integer stock_before
        integer stock_after
        varchar idempotency_key UK
        bytea request_fingerprint
        text reason
        timestamptz created_at
    }
    REDEMPTION_CREDENTIALS {
        uuid id PK
        uuid exchange_order_id FK
        bytea token_hash UK
        timestamptz issued_at
        timestamptz expires_at
        timestamptz revoked_at
        timestamptz consumed_at
        uuid consumed_by_account_id FK
    }
    SYSTEM_CONFIGS {
        uuid id PK
        varchar key UK
        jsonb value
        varchar description
        uuid updated_by_account_id FK
        timestamptz created_at
        timestamptz updated_at
    }
    OPERATION_LOGS {
        uuid id PK
        uuid actor_account_id FK
        varchar actor_role
        varchar action
        varchar module
        varchar target_type
        uuid target_id
        text summary
        jsonb before_data
        jsonb after_data
        varchar request_id
        timestamptz created_at
    }
    ACCOUNTS ||--o| STAFF_PROFILES : "account_id"
    ACCOUNTS ||--o| MEMBERS : "account_id"
