    MEMBERS ||--o{ FOLLOWUP_TASKS : "member_id"
    MEMBERS ||--o{ EXCHANGE_ORDERS : "member_id"
    PRODUCTS ||--o{ EXCHANGE_ORDERS : "product_id"
    ACCOUNTS |o--o{ EXCHANGE_ORDERS : "verified_by_account_id"
    EXCHANGE_ORDERS |o--o| PRODUCT_STOCK_RECORDS : "exchange_order_id"
    ACCOUNTS |o--o{ PRODUCT_STOCK_RECORDS : "operator_account_id"
